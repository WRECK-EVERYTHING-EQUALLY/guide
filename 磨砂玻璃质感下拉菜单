<!doctype html>
<html lang="zh-CN">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>磨砂玻璃下拉菜单动画</title>
<style>
*{box-sizing:border-box}html{background:#f5f5f5}body{margin:0;font-family:system-ui,"Microsoft YaHei",sans-serif;color:#eee}button{font:inherit;cursor:pointer;-webkit-tap-highlight-color:transparent}button:focus-visible{outline:2px solid #aaa;outline-offset:6px}header{height:60px;position:relative;z-index:30;background:rgba(242,246,248,.22);backdrop-filter:blur(24px) saturate(150%);-webkit-backdrop-filter:blur(24px) saturate(150%);display:flex;align-items:center;justify-content:space-between;padding:0 26px}.mark{width:16px;height:16px;border:1.5px solid #53656a;border-radius:4px;transform:rotate(-12deg)}.toggle{border:0;background:none;color:inherit;width:44px;height:44px;position:relative}.toggle span{position:absolute;left:14px;width:17px;height:1px;background:#384e54;top:18px;transition:transform 350ms ease,top 350ms ease}.toggle span+span{top:25px}.open .toggle span{top:22px;transform:rotate(45deg)}.open .toggle span+span{top:22px;transform:rotate(-45deg)}main{min-height:calc(100svh - 60px);background:#f1f1f1;transition:filter 650ms ease,transform 650ms ease;transform-origin:top}.open main{filter:none;transform:scale(1.015)}.background{height:60svh;min-height:300px;background:linear-gradient(130deg,#c4d9de,#d5e1cd 55%,#c1cfe8);display:grid;grid-template-columns:1fr 1fr;gap:16px;padding:clamp(24px,6vw,80px)}.block{border-radius:3px;background:#84b7aa}.block:nth-child(2){background:#e4d6a8}.block:nth-child(3){background:#6993a7}.block:nth-child(4){background:#c5b1cf}.hint{color:#808087;margin:0;padding:45px 24px;text-align:center;font-size:13px;letter-spacing:1px}.panel{position:fixed;z-index:20;inset:0;visibility:hidden;clip-path:inset(0 0 100% 0);background:rgba(235,246,250,.16);backdrop-filter:blur(19px) saturate(180%) contrast(1.04);-webkit-backdrop-filter:blur(19px) saturate(180%) contrast(1.04);box-shadow:inset 0 1px 0 #ffffffd9,inset 1px 0 0 #ffffff66,inset -1px 0 0 #ffffff33,0 18px 65px #244e6220;transition:clip-path 620ms cubic-bezier(.32,.72,.22,1),visibility 0s 620ms;overflow-y:auto;overscroll-behavior:contain;padding:clamp(78px,12svh,115px) max(40px,calc((100vw - 1050px)/2)) 40px}.open .panel{visibility:visible;clip-path:inset(0);transition:clip-path 650ms cubic-bezier(.22,.8,.2,1),visibility 0s}.menu{position:relative;z-index:2;display:flex;flex-direction:column;align-items:flex-start;gap:12px;margin:0;padding:0;list-style:none}.menu li{opacity:0;transform:translateY(-12px);filter:blur(3px);transition:opacity 160ms ease,transform 220ms ease,filter 200ms ease}.open .menu li{opacity:1;transform:translateY(0);filter:blur(0);transition-duration:420ms;transition-delay:calc(130ms + var(--i)*35ms)}.menu button{background:none;border:0;padding:0;color:#183840;text-shadow:0 1px 1px #ffffff70;line-height:1.35;font-size:clamp(25px,3.5vw,36px);font-weight:550;letter-spacing:-.5px}.menu button:hover{color:#0a222b}.open{overflow:hidden}@media(max-width:600px){header{height:52px;padding:0 14px}.panel{padding:83px 42px 40px}.menu{gap:12px}.menu button{font-size:26px}.background{height:58svh;padding:24px;gap:12px}}@media(prefers-reduced-motion:reduce){*,*::before{transition:none!important}}

.panel::before{content:"";position:fixed;inset:0;pointer-events:none;background:radial-gradient(ellipse at 0% 5%,#ffffff85,transparent 48%),linear-gradient(120deg,#ffffff26 0%,transparent 36%,#ffffff10 65%,#ffffff45 100%);z-index:0}
.panel::after{content:"";position:fixed;left:-60%;top:-30%;width:65%;height:170%;pointer-events:none;background:linear-gradient(90deg,transparent,#ffffff30,transparent);transform:rotate(24deg) translateX(-30%);opacity:0;z-index:1}
.open .panel::after{animation:gloss 1100ms cubic-bezier(.2,.7,.2,1) both}
@keyframes gloss{0%{transform:rotate(24deg) translateX(-30%);opacity:0}25%{opacity:.7}100%{transform:rotate(24deg) translateX(230%);opacity:0}}
.background{position:relative;overflow:hidden;background:radial-gradient(ellipse at 12% 35%,#77c4bc,transparent 60%),radial-gradient(ellipse at 88% 25%,#f0daa3,transparent 58%),radial-gradient(ellipse at 65% 90%,#a9b9e1,transparent 65%),#cbdedc}
.block{border-radius:36%;transform:rotate(-14deg);box-shadow:inset 0 2px 3px #ffffff75,0 24px 70px #3b7e8218}.block:nth-child(2){border-radius:50%;transform:translateY(-15%) rotate(16deg)}.block:nth-child(3){border-radius:50%;transform:translate(-8%,12%)}.block:nth-child(4){transform:rotate(22deg) translate(8%,5%)}
@media(prefers-reduced-motion:reduce){.panel::after{animation:none!important}}
</style></head>
<body><header><span class="mark" aria-hidden="true"></span><button class="toggle" id="toggle" aria-label="打开菜单" aria-expanded="false" aria-controls="panel"><span></span><span></span></button></header>
<main id="background"><div class="background" aria-hidden="true"><div class="block"></div><div class="block"></div><div class="block"></div><div class="block"></div></div><p class="hint">点击右上角，展开磨砂玻璃菜单</p></main>
<section class="panel" id="panel" role="dialog" aria-modal="true" aria-label="导航菜单" aria-hidden="true" inert><ul class="menu">
<li style="--i:0"><button>首页</button></li><li style="--i:1"><button>探索</button></li><li style="--i:2"><button>作品</button></li><li style="--i:3"><button>项目</button></li><li style="--i:4"><button>灵感</button></li><li style="--i:5"><button>收藏</button></li><li style="--i:6"><button>关于</button></li><li style="--i:7"><button>联系</button></li>
</ul></section>
<script>
const toggle=document.querySelector('#toggle'),panel=document.querySelector('#panel'),background=document.querySelector('#background');let opened=false;
function setOpen(value){opened=value;document.body.classList.toggle('open',value);toggle.setAttribute('aria-expanded',String(value));toggle.setAttribute('aria-label',value?'关闭菜单':'打开菜单');panel.inert=!value;panel.setAttribute('aria-hidden',String(!value));background.inert=value;if(!value)toggle.focus({preventScroll:true})}
toggle.onclick=()=>setOpen(!opened);panel.querySelectorAll('button').forEach(button=>button.onclick=()=>setOpen(false));
document.addEventListener('keydown',event=>{if(!opened)return;if(event.key==='Escape'){event.preventDefault();setOpen(false)}if(event.key==='Tab'){const focusable=[toggle,...panel.querySelectorAll('button')];const index=focusable.indexOf(document.activeElement);if(event.shiftKey&&(index<=0)){event.preventDefault();focusable.at(-1).focus()}else if(!event.shiftKey&&(index===focusable.length-1||index<0)){event.preventDefault();toggle.focus()}}});
</script></body></html>
