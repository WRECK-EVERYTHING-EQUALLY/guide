<!doctype html>
<html lang="zh-CN">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>黑色下拉菜单动画</title>
<style>
*{box-sizing:border-box}html{background:#f5f5f5}body{margin:0;font-family:system-ui,"Microsoft YaHei",sans-serif;color:#eee}button{font:inherit;cursor:pointer;-webkit-tap-highlight-color:transparent}button:focus-visible{outline:2px solid #aaa;outline-offset:6px}header{height:60px;position:relative;z-index:30;background:#161617;display:flex;align-items:center;justify-content:space-between;padding:0 26px}.mark{width:16px;height:16px;border:1.5px solid #c0c0c5;border-radius:4px;transform:rotate(-12deg)}.toggle{border:0;background:none;color:inherit;width:44px;height:44px;position:relative}.toggle span{position:absolute;left:14px;width:17px;height:1px;background:#ddd;top:18px;transition:transform 350ms ease,top 350ms ease}.toggle span+span{top:25px}.open .toggle span{top:22px;transform:rotate(45deg)}.open .toggle span+span{top:22px;transform:rotate(-45deg)}main{min-height:calc(100svh - 60px);background:#f1f1f1;transition:filter 650ms ease,transform 650ms ease;transform-origin:top}.open main{filter:blur(9px) brightness(.55);transform:scale(.985)}.background{height:60svh;min-height:300px;background:#b9cfc4;display:grid;grid-template-columns:1fr 1fr;gap:16px;padding:clamp(24px,6vw,80px)}.block{border-radius:3px;background:#8aa99d}.block:nth-child(2){background:#dce4cc}.block:nth-child(3){background:#466e62}.block:nth-child(4){background:#a7beb2}.hint{color:#808087;margin:0;padding:45px 24px;text-align:center;font-size:13px;letter-spacing:1px}.panel{position:fixed;z-index:20;inset:0;visibility:hidden;clip-path:inset(0 0 100% 0);background:rgba(22,22,23,.985);backdrop-filter:blur(24px);transition:clip-path 620ms cubic-bezier(.32,.72,.22,1),visibility 0s 620ms;overflow-y:auto;overscroll-behavior:contain;padding:clamp(78px,12svh,115px) max(40px,calc((100vw - 1050px)/2)) 40px}.open .panel{visibility:visible;clip-path:inset(0);transition:clip-path 650ms cubic-bezier(.22,.8,.2,1),visibility 0s}.menu{display:flex;flex-direction:column;align-items:flex-start;gap:12px;margin:0;padding:0;list-style:none}.menu li{opacity:0;transform:translateY(-12px);filter:blur(3px);transition:opacity 160ms ease,transform 220ms ease,filter 200ms ease}.open .menu li{opacity:1;transform:translateY(0);filter:blur(0);transition-duration:420ms;transition-delay:calc(130ms + var(--i)*35ms)}.menu button{background:none;border:0;padding:0;color:#e8e8ed;line-height:1.35;font-size:clamp(25px,3.5vw,36px);font-weight:550;letter-spacing:-.5px}.menu button:hover{color:#fff}.open{overflow:hidden}@media(max-width:600px){header{height:52px;padding:0 14px}.panel{padding:83px 42px 40px}.menu{gap:12px}.menu button{font-size:26px}.background{height:58svh;padding:24px;gap:12px}}@media(prefers-reduced-motion:reduce){*,*::before{transition:none!important}}
</style></head>
<body><header><span class="mark" aria-hidden="true"></span><button class="toggle" id="toggle" aria-label="打开菜单" aria-expanded="false" aria-controls="panel"><span></span><span></span></button></header>
<main id="background"><div class="background" aria-hidden="true"><div class="block"></div><div class="block"></div><div class="block"></div><div class="block"></div></div><p class="hint">点击右上角，展开菜单</p></main>
<section class="panel" id="panel" role="dialog" aria-modal="true" aria-label="导航菜单" aria-hidden="true" inert><ul class="menu">
<li style="--i:0"><button>首页</button></li><li style="--i:1"><button>探索</button></li><li style="--i:2"><button>作品</button></li><li style="--i:3"><button>项目</button></li><li style="--i:4"><button>灵感</button></li><li style="--i:5"><button>收藏</button></li><li style="--i:6"><button>关于</button></li><li style="--i:7"><button>联系</button></li>
</ul></section>
<script>
const toggle=document.querySelector('#toggle'),panel=document.querySelector('#panel'),background=document.querySelector('#background');let opened=false;
function setOpen(value){opened=value;document.body.classList.toggle('open',value);toggle.setAttribute('aria-expanded',String(value));toggle.setAttribute('aria-label',value?'关闭菜单':'打开菜单');panel.inert=!value;panel.setAttribute('aria-hidden',String(!value));background.inert=value;if(!value)toggle.focus({preventScroll:true})}
toggle.onclick=()=>setOpen(!opened);panel.querySelectorAll('button').forEach(button=>button.onclick=()=>setOpen(false));
document.addEventListener('keydown',event=>{if(!opened)return;if(event.key==='Escape'){event.preventDefault();setOpen(false)}if(event.key==='Tab'){const focusable=[toggle,...panel.querySelectorAll('button')];const index=focusable.indexOf(document.activeElement);if(event.shiftKey&&(index<=0)){event.preventDefault();focusable.at(-1).focus()}else if(!event.shiftKey&&(index===focusable.length-1||index<0)){event.preventDefault();toggle.focus()}}});
</script></body></html>
