<!doctype html>
<html lang="zh-CN">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>叠卡翻页动画</title>
<style>
*{box-sizing:border-box}html,body{margin:0;min-height:100%;background:#fafafa;font-family:system-ui,sans-serif}body{min-height:100svh;display:grid;place-items:center;overflow-x:hidden}main{width:100%;display:grid;justify-items:center;gap:32px;padding:36px 0}.stage{--width:min(330px,72vw,48svh);width:calc(var(--width) + 60px);height:calc(var(--width)*1.49);position:relative;touch-action:pan-y;user-select:none;cursor:grab;outline:none}.stage:active{cursor:grabbing}.card{position:absolute;top:0;left:0;width:var(--width);height:100%;border-radius:7px;overflow:hidden;background:#ddd;transform-origin:center;will-change:transform,opacity;transition:transform 680ms cubic-bezier(.25,.7,.25,1),opacity 680ms ease;box-shadow:0 3px 9px #0000000a}.card:nth-child(1){background:#c7d8e8}.card:nth-child(2){background:#d7cce3}.card:nth-child(3){background:#c9dcd2}.card:nth-child(4){background:#e7d4c4}.card.no-motion{transition:none}.controls{display:flex;gap:14px;align-items:center}button{border:0;width:40px;height:40px;border-radius:50%;background:#eeeeef;color:#555;cursor:pointer;display:grid;place-items:center;font:20px system-ui}button:hover{background:#e2e2e5}button:focus-visible,.stage:focus-visible{outline:2px solid #707781;outline-offset:6px}.dots{display:flex;gap:6px;margin:0 5px}.dot{width:18px;height:34px;border-radius:5px;background:transparent}.dot:before{content:'';width:5px;height:5px;border-radius:100%;background:#ccc}.dot[aria-current=true]:before{background:#555}.dot:hover{background:transparent}.play{font-size:13px}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}@media(prefers-reduced-motion:reduce){.card{transition:none}}
</style></head><body>
<main><div class="stage" tabindex="0" role="region" aria-roledescription="轮播" aria-label="叠卡翻页，左右滑动或使用方向键">
<div class="card" role="img" aria-label="纯色卡片"></div>
<div class="card" role="img" aria-label="纯色卡片"></div>
<div class="card" role="img" aria-label="纯色卡片"></div>
<div class="card" role="img" aria-label="纯色卡片"></div>
</div><div class="controls"><button id="prev" aria-label="上一张">‹</button><div class="dots" aria-label="选择卡片"></div><button id="next" aria-label="下一张">›</button><button class="play" aria-label="暂停" aria-pressed="true">Ⅱ</button></div><span class="sr-only" id="status" aria-live="polite"></span></main>
<script>
const cards=[...document.querySelectorAll('.card')],stage=document.querySelector('.stage'),play=document.querySelector('.play'),reduced=matchMedia('(prefers-reduced-motion: reduce)');
let current=0,busy=false,playing=!reduced.matches,timer,start=null;
cards.forEach((_,i)=>{let b=document.createElement('button');b.className='dot';b.setAttribute('aria-label','第'+(i+1)+'张');b.onclick=()=>change(i);document.querySelector('.dots').append(b)});
const dots=[...document.querySelectorAll('.dot')];
function pose(card,depth){card.style.transform=`translateX(${depth*19}px) scale(${1-depth*.085})`;card.style.opacity='1';card.style.zIndex=String(10-depth)}
function sync(){cards.forEach((card,i)=>{let depth=(i-current+4)%4;pose(card,depth);card.setAttribute('aria-hidden',String(depth!==0));dots[i].setAttribute('aria-current',String(depth===0))});stage.dataset.current=current}
function schedule(){clearTimeout(timer);if(playing&&!document.hidden)timer=setTimeout(()=>change((current+1)%4),1900)}
function change(target){if(busy||target===current)return;schedule();busy=true;const old=cards[current],backward=target===(current+3)%4;current=target;
 if(backward){const incoming=cards[current];incoming.classList.add('no-motion');incoming.style.transform='translateX(-95%) scale(1.015)';incoming.style.opacity='0';incoming.style.zIndex='12';void incoming.offsetWidth;incoming.classList.remove('no-motion');sync();incoming.style.zIndex='12'}
 else{sync();old.style.zIndex='12';old.style.transform='translateX(-95%) scale(1.015)';old.style.opacity='0'}
 document.querySelector('#status').textContent='第 '+(current+1)+' 张';
 setTimeout(()=>{cards.forEach(c=>c.classList.add('no-motion'));sync();void stage.offsetWidth;cards.forEach(c=>c.classList.remove('no-motion'));busy=false;schedule()},reduced.matches?0:700)
}
function playback(){play.textContent=playing?'Ⅱ':'▶';play.setAttribute('aria-label',playing?'暂停':'播放');play.setAttribute('aria-pressed',String(playing));schedule()}
play.onclick=()=>{playing=!playing;playback()};document.querySelector('#next').onclick=()=>change((current+1)%4);document.querySelector('#prev').onclick=()=>change((current+3)%4);
stage.onkeydown=e=>{if(['ArrowLeft','ArrowRight'].includes(e.key)){e.preventDefault();change((current+(e.key==='ArrowRight'?1:3))%4)}};
stage.onpointerdown=e=>{if(e.pointerType==='mouse'&&e.button!==0)return;start=[e.clientX,e.clientY];stage.setPointerCapture(e.pointerId)};
stage.onpointerup=e=>{if(!start)return;const dx=e.clientX-start[0],dy=e.clientY-start[1];start=null;if(Math.abs(dx)>35&&Math.abs(dx)>Math.abs(dy))change((current+(dx<0?1:3))%4)};stage.onpointercancel=()=>start=null;
document.addEventListener('visibilitychange',schedule);sync();playback();
</script></body></html>
